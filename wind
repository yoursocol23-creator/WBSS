["Windy-1.matcha.tracking.luau"]=[==[-- Seed existing children after subscribing. Rescan deliberately replays children
-- so callers can reclassify effects after a feature toggle changes.
local Tracking = {}

function Tracking.Connect(folder, callback)
 assert(folder and type(callback)=="function", "Tracking.Connect expects a folder and callback")
 local connection={Connected=true}
 local seen={}
 local added,removed
 local function identity(child)
  local address=child and child.Address
  if address and address~=0 then return address end
  return child
 end
 local function deliver(child, replay)
  if not connection.Connected then return end
  local id=identity(child)
  if not id or (seen[id] and not replay) then return end
  seen[id]=true
  callback(child)
 end
 function connection:Disconnect()
  if not self.Connected then return end
  self.Connected=false
  if added then added:Disconnect() end
  if removed then removed:Disconnect() end
  seen={}
 end
 function connection:Rescan()
  if not self.Connected then return end
  local current={}
  for _,child in ipairs(folder:GetChildren()) do
   if not self.Connected then break end
   local id=identity(child)
   if id and not current[id] then
    current[id]=true
    deliver(child,true)
   end
  end
 end
 -- Listen for removals first: an object removed and readded at the same
 -- address is a fresh arrival and must be delivered again.
 if folder.ChildRemoved then
  removed=folder.ChildRemoved:Connect(function(child)
   if connection.Connected then seen[identity(child)]=nil end
  end)
 end
 added=folder.ChildAdded:Connect(function(child) deliver(child,false) end)
 local ok,reason=pcall(function()
  for _,child in ipairs(folder:GetChildren()) do deliver(child,false) end
 end)
 if not ok then connection:Disconnect();error(reason,0) end
 return connection
end

return Tracking
]==],
["Windy-1.matcha.sprinklers.luau"]=[==[-- Windy's equipped-tier layouts with acknowledgement-based placement.
return function(host)
 local api={}
 function api:Plan(name,center,size,mode)
  local V=host.Vector3
  if name=="Basic Sprinkler"or name=="The Supreme Saturator"then
   return{center+V.new(0,0,mode=="Top"and-size.Z/4 or mode=="Bottom"and size.Z/4 or 0)}
  end
  local offsets=({["Silver Soakers"]={{-12,-12},{12,12}},["Golden Gushers"]={{12,-12},{-16,-12},{0,12}},["Diamond Drenchers"]={{-16,0},{16,0},{0,16},{0,-16}}})[name]
  if not offsets then return nil end
  local plan={};for _,offset in offsets do plan[#plan+1]=center+V.new(offset[1],0,offset[2])end
  return plan
 end
 function api:Place(positions,ctx)
  for index,point in ipairs(positions)do
   if not ctx.active()then return false,"cancelled"end
   local moved=ctx.walk(point)
   if moved==false or not ctx.active()then return false,"movement failed"end
   if index>1 then ctx.jump();ctx.wait(.2)else ctx.wait(.1)end
   local success=false
   for attempt=1,2 do
    if not ctx.active()then return false,"cancelled"end
    ctx.request(index,point)
    for _=1,12 do
     ctx.wait(.1)
     if not ctx.active()then return false,"cancelled"end
     if ctx.confirmed(index,point)then success=true;break end
    end
    if success then break end
   end
   if not success then return false,"placement was not confirmed"end
   if index<#positions then ctx.wait(.8)end
  end
  return true
 end
 return api
end
