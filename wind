local function planterTimeLeft(planter, withName, v67)
	if not planter then
		return
	end
	local harvestSeconds = nil
	local holdForReward = nil

	if v67 then
		local remainingHours = cfg.planters.nectar.timetoharvest - planter.percent.Value * planterInfo[planter.name]
		local remainingSeconds

		if not (remainingHours < 0) then
			remainingSeconds = remainingHours * 3600
		else
			remainingSeconds = 0
		end

		if remainingSeconds / 60 >= 60 then
			return string.format("%dh %02dm %02ds", math.floor(remainingSeconds / 3600), math.floor(remainingSeconds / 60 % 60), math.floor(remainingSeconds % 60))
		end

		if remainingSeconds > 60 then
			return string.format("%dm %02ds", math.floor(remainingSeconds / 60), math.floor(remainingSeconds % 60))
		end
		return math.floor(remainingSeconds) .. "s"
	end

	if cfg.planters.rewards.enabled then
		local swirledInfo = planterInfo.swirled[planter.name]

		if not (not swirledInfo or swirledInfo.field ~= planter.field) then
			local swirled = planterInfo.timers.swirled
			swirled = swirled and swirled[planter.name]

			if not swirled or swirledInfo.cooldown < os.time() - swirled then
				holdForReward = true
			end
		end

		if not holdForReward then
			local causticInfo = planterInfo.caustic[planter.name]

			if not (not causticInfo or causticInfo.field ~= planter.field) then
				local caustic = planterInfo.timers.caustic
				caustic = caustic and caustic[planter.name]

				if not caustic or causticInfo.cooldown < os.time() - caustic then
					holdForReward = true
				end
			end
		end
	end

	if not (not cfg.autoquest.enabled or not cfg.autoquest.planters or not planterInfo.data) then
		for _, questItem in ipairs(planterInfo.data) do
			if not ((questItem.Type ~= "Planter Items" or not isPlanterItemConflict(planter.name, planter.field, questItem.Item)) and (questItem.Type ~= "Planter Tokens" or not (not questItem.Field or questItem.Field == planter.field))) then
				holdForReward = true
			end
		end
	end

	if not holdForReward and not (cfg.planters.method ~= "Nectar" or not cfg.planters.nectar.harvestaftertime or not planterInfo[planter.name]) then
		local remainingHours = cfg.planters.nectar.timetoharvest - planter.percent.Value * planterInfo[planter.name]

		if not (remainingHours < 0) then
			harvestSeconds = remainingHours * 3600
		else
			harvestSeconds = 0
		end
	elseif not holdForReward and not (cfg.planters.method ~= "Cycles" or not cfg.planters.cycles.lastcycle) then
		local cycleConfig = cfg.planters.cycles["cycle" .. cfg.planters.cycles.lastcycle]

		if not (not cycleConfig.harvestaftertime or not cfg.planters.cycles.started) then
			local started = cfg.planters.cycles.started
			harvestSeconds = cycleConfig.timetoharvest * 3600 - (os.time() - started)

			if harvestSeconds < 0 then
				harvestSeconds = 0
			end
		end
	end

	if not harvestSeconds then
		if not withName then
			return math.floor(planter.percent.Value * 100) .. "%"
		end
		local fieldSuffix = " (" .. planter.field .. ")"
		return string.gsub(string.gsub(planter.textLabel.Text, " %(", ": "), "%)", "") .. fieldSuffix
	end

	local timeText

	if harvestSeconds / 60 >= 60 then
		timeText = string.format("%02i:%02i:%02i", math.floor(harvestSeconds / 60 / 60), math.floor(harvestSeconds / 60 % 60), math.floor(harvestSeconds % 60))
	elseif harvestSeconds > 60 then
		timeText = string.format("%02i:%02i", math.floor(harvestSeconds / 60), math.floor(harvestSeconds % 60))
	else
		timeText = math.floor(harvestSeconds) .. "s"
	end

	if not withName then
		return timeText .. " left"
	end
	return planter.name .. ": " .. timeText .. " left" .. " (" .. planter.field .. ")"
end

