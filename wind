["Windy-1.matcha.platform.luau"]=[==[-- Local combat support surfaces only; these do not create Roblox Instances.
return function(host,instances)
 local api={}
 local active={}
 local running=false
 local function support(part,root,humanoid)
  if not part.Parent or not part.Position or not part.Size or part.CanCollide==false then return end
  local h=instances and instances.wrap(humanoid)or humanoid
  local hip=h.HipHeight
  if type(hip)~="number"then return end
  local p,s,r=part.Position,part.Size,root.Position
  local v=root.AssemblyLinearVelocity
  if not r or not v or v.Y>0 then return end
  local orientation=part.Orientation
  local ax,ay,az=0,0,0
  if orientation then ax,ay,az=math.rad(orientation.X),math.rad(orientation.Y),math.rad(orientation.Z)end
  local cx,sx,cy,sy,cz,sz=math.cos(ax),math.sin(ax),math.cos(ay),math.sin(ay),math.cos(az),math.sin(az)
  -- XYZ Euler rotation columns; intersect a world-vertical line with the
  -- upper broad face, then test its local X/Z coordinates against the box.
  local xx,xy,xz=cy*cz,cx*sz+sx*sy*cz,sx*sz-cx*sy*cz
  local nx,ny,nz=-cy*sz,cx*cz-sx*sy*sz,sx*cz+cx*sy*sz
  local zx,zy,zz=sy,-sx*cy,cx*cy
  if math.abs(ny)<.1 then return end
  local dx,dz=r.X-p.X,r.Z-p.Z
  local dy=((ny>0 and 1 or -1)*s.Y/2-nx*dx-nz*dz)/ny
  local localX,localZ=xx*dx+xy*dy+xz*dz,zx*dx+zy*dy+zz*dz
  if math.abs(localX)>s.X/2 or math.abs(localZ)>s.Z/2 then return end
