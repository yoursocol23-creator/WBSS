	discord.GraphStart = function(v121, enabled)
		if not enabled or threads:Get("webhookgraph") then
			if not enabled then
				threads:Cancel("webhookgraph")
			end
		else
			v121.graph = deepCopy(v121.default_graph)

			threads:Add("webhookgraph", function()
				v121.hourstart = os.time()
				v121.start = os.time()
				local lastBucket = -1

				while true do
					local hourstart = v121.hourstart
					local elapsedSeconds = os.time() - hourstart
					local elapsedMinutes = math.floor(elapsedSeconds / 60)
					local graph = v121.graph
					local value = localPlayer.CoreStats.Honey.Value
					local pollenPercent = math.floor(localPlayer.CoreStats.Pollen.Value / localPlayer.CoreStats.Capacity.Value * 100)

					if pollenPercent > 100 then
						pollenPercent = 100
					end

					graph.honey_values[tostring(elapsedMinutes)] = value
					graph.backpack_values[tostring(elapsedSeconds)] = pollenPercent
					local bucket = math.floor(elapsedMinutes / 4)

					if math.floor(lastBucket / 4) < bucket then
						lastBucket = elapsedMinutes

						for i = 1, 180 do
							local honey12h = graph.honey_12h
							graph.honey_12h[tostring(i - 1)] = honey12h[tostring(i)]
						end
					end

					graph.honey_12h["180"] = value
					local bucketKey = tostring(math.floor(elapsedSeconds / 6))

					for k, buffValue in pairs(graph.buff_values) do
						local buffTile = buffs.Graph[k]
						if not buffTile then
							buffValue[bucketKey] = 0
							continue
						end
						local tonumber_ = tonumber
						local buffText = string.gsub(buffTile.Text, "x", "")
						buffValue[bucketKey] = tonumber_(buffText) or 1
					end

					for k, buffValues in pairs(graph.buff_values2) do
						local buffTile = buffs.Graph[k]
						if not buffTile then
							buffValues[bucketKey] = 0
							continue
						end
						local tonumber_ = tonumber
						local buffText = string.gsub(buffTile.Text, "x", "")
						buffValues[bucketKey] = tonumber_(buffText) or 1
					end

					pcall(function()
						local n = secureCall(gameApi.BuffTile, "Field Corruption")
						graph.buff_values2.fieldcorruption[bucketKey] = n and math.floor((n.Mods[1].MinValue + n.Mods[1].ValuePerStack * (n.Combo - 1)) * 1000) / 10 or nil

						for n, n in ipairs(workspace.Balloons.HiveBalloons:GetChildren()) do
							if n.BalloonRoot.Position.X == localPlayer.SpawnPos.Value.Position.X then
								graph.buff_values2.balloonpollen[bucketKey] = tonumber((string.gsub(n.BalloonBody.GuiAttach.Gui.Bar.TextLabel.Text, ",", ""))) or nil
							end
						end
					end)

					for _, buffName in ipairs({ "clock", "blessing", "bloat", "tideblessing", "mondo" }) do
						local buffTile = buffs.Graph[buffName]
						local staticBuffValues = graph.static_buff_values
						local buffNumber = buffTile

						if buffNumber then
							local tonumber_ = tonumber
							local buffText = string.gsub(buffTile.Text, "x", "")
							buffNumber = tonumber_(buffText)
						end

						staticBuffValues[buffName] = buffNumber or 0
					end

					for _, nectarName in ipairs({ "Comforting", "Motivating", "Satisfying", "Refreshing", "Invigorating" }) do
						local nectarBuff = buffs.Nectar[nectarName]
						graph.static_buff_values[string.lower(nectarName)] = nectarBuff and math.floor(nectarBuff.Size.Y.Scale * 100) or 0
					end

					if not (elapsedMinutes > 59) then
						task.wait(1)
						continue
					end
					v121:SendGraph()
					v121.hourstart = os.time()
					v121.statsold = {}
					lastBucket = -1

					for k, stat in pairs(discord.stats) do
						v121.statsold[k] = stat
					end

					local copy = deepCopy(v121.default_graph)
					copy.honey_12h = graph.honey_12h
					copy.gatherTime = graph.gatherTime
					copy.convertTime = graph.convertTime
					copy.otherTime = graph.otherTime
					v121.graph = copy
				end
			end)
		end
	end

