function UI:CreateImage(bucket, data, x, y, w, h, transparency)
    if self.logoImageUnsupported then
        return nil
    end
    local image = self:AcquireDrawing(bucket, "Image")
    if not image then
        self.logoImageUnsupported = true
        return nil
    end
    if not self:DrawingBoxInsideClip(x, y, w, h) then
        if bucket then bucket.activeVisibility[bucket.cursor] = false end
        self:SetDrawingProperty(image, "Visible", false)
        return image
    end

    local tx, ty = self:TransformPoint(x, y)
    local tw, th = self:TransformSize(w, h)
    local applied = pcall(function()
        self:SetDrawingProperty(image, "Position", Vector2.new(tx, ty))
        self:SetDrawingProperty(image, "Size", Vector2.new(tw, th))
        self:SetDrawingZIndex(image, 80000, bucket)
        self:SetDrawingProperty(image, "Visible", not (bucket and bucket.deferVisible))
        self:SetDrawingProperty(image, "Transparency", self:GetRenderTransparency(transparency or 1), 0.001)
        self:SetDrawingProperty(image, "Data", data)
    end)

    if not applied then
        self.logoImageUnsupported = true
        pcall(function()
            image.Visible = false
        end)
        if bucket and bucket.objects and bucket.objects[bucket.cursor] == image then
            bucket.cursor = math.max(0, (bucket.cursor or 1) - 1)
        end
        return nil
    end

    return image
end

function UI:CreateRoundedBox(bucket, x, y, w, h, radius, color, transparency)
    radius = math.floor(math.max(0, math.min(radius or 0, math.min(w, h) / 2)))
    if radius <= 0 then
        self:CreateSquare(bucket, x, y, w, h, color, transparency or 1, true)
        return
    end

    self:CreateSquare(bucket, x + radius, y, w - (radius * 2), h, color, transparency or 1, true)
    self:CreateSquare(bucket, x, y + radius, w, h - (radius * 2), color, transparency or 1, true)
    self:CreateCircle(bucket, x + radius, y + radius, radius, color, transparency or 1, true)
    self:CreateCircle(bucket, x + w - radius, y + radius, radius, color, transparency or 1, true)
    self:CreateCircle(bucket, x + radius, y + h - radius, radius, color, transparency or 1, true)
    self:CreateCircle(bucket, x + w - radius, y + h - radius, radius, color, transparency or 1, true)
end

function UI:DrawRoundedWindow(bucket, x, y, w, h)
    local radius = 4

    
    self:CreateRoundedBox(bucket, x - 1, y - 1, w + 2, h + 2, radius + 1, Theme.dark or Color3.new(0, 0, 0))
    self:CreateRoundedBox(bucket, x, y, w, h, radius, Theme.border)
    self:CreateRoundedBox(bucket, x + 1, y + 1, w - 2, h - 2, math.max(0, radius - 1), Theme.bg)
end

function UI:DrawLeftRoundedPanel(bucket, x, y, w, h, radius, color)
    radius = math.floor(math.max(0, radius or 0))

    
    self:CreateSquare(bucket, x, y + radius, w, h - (radius * 2), color, 1, true)

    
    self:CreateSquare(bucket, x + radius, y, w - radius, radius, color, 1, true)
    self:CreateSquare(bucket, x + radius, y + h - radius, w - radius, radius, color, 1, true)

    
    self:CreateCircle(bucket, x + radius, y + radius, radius, color, 1, true)
    self:CreateCircle(bucket, x + radius, y + h - radius, radius, color, 1, true)

    
    self:CreateSquare(bucket, x + radius, y, w - radius, h, color, 1, true)
end

function UI:DrawRoundedBar(bucket, x, y, w, h, fillPercent)
    local radius = 2
    local pct = math.clamp(fillPercent or 0, 0, 1)

    self:CreateRoundedBox(bucket, x, y, w, h, radius, Theme.border)
    self:CreateRoundedBox(bucket, x + 1, y + 1, w - 2, h - 2, radius, Theme.panel)

    local fillW = math.floor((w - 2) * pct)
    if fillW > 0 then
        self:CreateRoundedBox(bucket, x + 1, y + 1, fillW, h - 2, radius, Theme.accent)
    end
end

function UI:AnimateValue(store, key, target, speed, dt, defaultValue)
    local current = store[key]
    if current == nil then
        current = defaultValue ~= nil and defaultValue or target
    end

    local nextValue = LerpNumber(current, target, SmoothFactor(speed or 12, dt))
    if math.abs(nextValue - target) < 0.001 then
        nextValue = target
    end

    store[key] = nextValue
    return nextValue, nextValue ~= target
end

function UI:GetAnimatedWindowYOffset()
    return math.floor(self.uiOffset + 0.5)
end

function UI:GetViewportSize()
    local camera = workspace and workspace.CurrentCamera or nil
    if camera and camera.ViewportSize then
        return camera.ViewportSize
    end

    return Vector2.new(1280, 720)
end

function UI:GetRenderWindowPosition()
    return math.floor((self.renderX or self.window.x) + 0.5), math.floor((self.renderY or self.window.y) + 0.5)
end

function UI:GetTransformCenter()
    local renderX, renderY = self:GetRenderWindowPosition()
    local baseY = renderY + self:GetAnimatedWindowYOffset()
    return renderX + (self.window.width * 0.5), baseY + (self.window.height * 0.5)
end

function UI:TransformPoint(x, y)
    local scale = self.renderScale or 1
    if math.abs(scale - 1) < 0.001 then
        return x, y
    end

    local centerX, centerY = self:GetTransformCenter()
    return centerX + ((x - centerX) * scale), centerY + ((y - centerY) * scale)
end

function UI:TransformSize(w, h)
    local scale = self.renderScale or 1
    if math.abs(scale - 1) < 0.001 then
        return w, h
    end

    return w * scale, h * scale
end

function UI:ResetContentAnimation()
    self.contentAlpha = 0
    self.contentOffset = 6
    self:MarkCurrentTabDirty()
end

function UI:UpdateAnimations(dt)
    self:WindyAnimate(dt)
    local tabStartY = 58
    local tabStep = 40

    if not self:AreAnimationsEnabled() then
        self.uiAlpha = self.uiVisible and 1 or 0
        self.uiOffset = 0
        self.renderX = self.window.x
        self.renderY = self.window.y
        self.renderScale = 1
        self.contentAlpha = self.uiVisible and 1 or 0
        self.contentOffset = 0
        self.activeTabHighlightY = tabStartY + ((self.selectedTab - 1) * tabStep)

        for tabIndex = 1, #self.tabs do
            self.animationState.tabHover[tabIndex] = self.hoveredId == ("tab_" .. tostring(tabIndex)) and 1 or 0
            self.animationState.tabActive[tabIndex] = self.selectedTab == tabIndex and 1 or 0
        end

        for _, tabControls in ipairs(self.controls or {}) do
            for _, control in ipairs(tabControls) do
                local controlType = self:GetControlType(control)
                local controlId = self:GetControlId(control)
                self.animationState.controlHover[controlId] = self.hoveredId == controlId and 1 or 0
                self.animationState.dropdownOpen[controlId] = self.expandedDropdown == controlId and 1 or 0

                if controlType == "slider" then
                    self.animationState.sliderFill[controlId] = self:GetSliderPercent(control)
                elseif controlType == "toggle" then
                    self.animationState.toggleFill[controlId] = self:GetControlRawValue(control, false) and 1 or 0
                elseif controlType == "checkbox" then
                    self.animationState.checkboxFill[controlId] = self:GetControlRawValue(control, false) and 1 or 0
                end
            end
        end

        local _, _, _, _, thumbTargetY = self:GetScrollbarMetrics()
        self.animatedScrollThumbY = thumbTargetY
        self.animationsActive = false
        return
    end

    local shellAnimating = false
    local tabAnimating = false

    local alphaTarget = self.uiVisible and 1 or 0
    self.uiAlpha = LerpNumber(self.uiAlpha or alphaTarget, alphaTarget, SmoothFactor(16, dt))
    if math.abs(self.uiAlpha - alphaTarget) < 0.002 then
        self.uiAlpha = alphaTarget
    else
        shellAnimating = true
        tabAnimating = true
    end

    local offsetTarget = self.uiVisible and 0 or 10
    self.uiOffset = LerpNumber(self.uiOffset or offsetTarget, offsetTarget, SmoothFactor(16, dt))
    if math.abs(self.uiOffset - offsetTarget) >= 0.02 then
        shellAnimating = true
        tabAnimating = true
    else
        self.uiOffset = offsetTarget
    end

    self.renderX = self.window.x
    self.renderY = self.window.y

    local scaleTarget = self.uiVisible and 1 or 0.2
    self.renderScale = LerpNumber(self.renderScale or scaleTarget, scaleTarget, SmoothFactor(16, dt))
    if math.abs((self.renderScale or scaleTarget) - scaleTarget) >= 0.002 then
        shellAnimating = true
        tabAnimating = true
    else
        self.renderScale = scaleTarget
    end

    local contentTarget = self.uiVisible and 1 or 0
    self.contentAlpha = LerpNumber(self.contentAlpha or contentTarget, contentTarget, SmoothFactor(14, dt))
    self.contentOffset = LerpNumber(self.contentOffset or 0, self.uiVisible and 0 or 4, SmoothFactor(14, dt))

    if math.abs(self.contentAlpha - contentTarget) >= 0.002
        or math.abs(self.contentOffset - (self.uiVisible and 0 or 4)) >= 0.02
    then
        tabAnimating = true
    else
        self.contentAlpha = contentTarget
        self.contentOffset = self.uiVisible and 0 or 4
    end

    local activeTabTargetY = tabStartY + ((self.selectedTab - 1) * tabStep)

    if self.draggingWindow then
        self.activeTabHighlightY = activeTabTargetY
    else
        self.activeTabHighlightY = LerpNumber(
            self.activeTabHighlightY or activeTabTargetY,
            activeTabTargetY,
            SmoothFactor(18, dt)
        )
    end

    if math.abs((self.activeTabHighlightY or activeTabTargetY) - activeTabTargetY) >= 0.02 then
        shellAnimating = true
    else
        self.activeTabHighlightY = activeTabTargetY
    end

    for tabIndex = 1, #self.tabs do
        local hoverTarget = self.hoveredId == ("tab_" .. tostring(tabIndex)) and 1 or 0
        local activeTarget = self.selectedTab == tabIndex and 1 or 0

        local _, hoverMoving = self:AnimateValue(self.animationState.tabHover, tabIndex, hoverTarget, 18, dt, 0)
        local _, activeMoving = self:AnimateValue(self.animationState.tabActive, tabIndex, activeTarget, 18, dt, activeTarget)

        shellAnimating = shellAnimating or hoverMoving or activeMoving
    end

    for _, tabControls in ipairs(self.controls or {}) do
        for _, control in ipairs(tabControls) do
            local controlType = self:GetControlType(control)
            local controlId = self:GetControlId(control)
            local hoverTarget = self.hoveredId == controlId and 1 or 0
            local _, hoverMoving = self:AnimateValue(self.animationState.controlHover, controlId, hoverTarget, 16, dt, 0)

            tabAnimating = tabAnimating or hoverMoving

            if controlType == "dropdown_single" or controlType == "dropdown_multi" then
                local _, moving = self:AnimateValue(
                    self.animationState.dropdownOpen,
                    controlId,
                    self.expandedDropdown == controlId and 1 or 0,
                    18,
                    dt,
                    0
                )

                tabAnimating = tabAnimating or moving

            elseif controlType == "slider" then
                local percent = self:GetSliderPercent(control)
                local _, moving = self:AnimateValue(self.animationState.sliderFill, controlId, percent, 14, dt, percent)

                tabAnimating = tabAnimating or moving

            elseif controlType == "toggle" then
                local target = self:GetControlRawValue(control, false) and 1 or 0
                local _, moving = self:AnimateValue(self.animationState.toggleFill, controlId, target, 16, dt, target)

                tabAnimating = tabAnimating or moving

            elseif controlType == "checkbox" then
                local target = self:GetControlRawValue(control, false) and 1 or 0
                local _, moving = self:AnimateValue(self.animationState.checkboxFill, controlId, target, 16, dt, target)

                tabAnimating = tabAnimating or moving
            end
        end
    end

    local _, _, _, _, thumbTargetY = self:GetScrollbarMetrics()
    self.animatedScrollThumbY = LerpNumber(self.animatedScrollThumbY or thumbTargetY, thumbTargetY, SmoothFactor(16, dt))

    if math.abs((self.animatedScrollThumbY or thumbTargetY) - thumbTargetY) >= 0.02 then
        tabAnimating = true
    else
        self.animatedScrollThumbY = thumbTargetY
    end

    self.animationsActive = shellAnimating or tabAnimating

    if shellAnimating then
        self:MarkShellDirty()
    end

    if tabAnimating then
        self:MarkCurrentTabDirty()
    end
end

function UI:DrawCardFrame(bucket, x, y, w, h, outlineColor)
    self:CreateSquare(bucket, x, y, w, h, Theme.card, 1, true)
    self:CreateSquare(bucket, x, y, w, h, outlineColor or Theme.border, 1, false, 1)
    self:CreateLine(bucket, x + 1, y + 1, x + w - 2, y + 1, Theme.topHighlight, 0.42, 1)
    self:CreateLine(bucket, x + 1, y + 2, x + w - 2, y + 2, Theme.cardInner, 0.2, 1)
end

function UI:RegisterHitbox(id, x, y, w, h, callback, priority)
    x, y, w, h = self:ClipDrawingBox(x, y, w, h)
    if not x then
        return
    end
    table.insert(self.hitboxes, {
        id = id,
        x = x,
        y = y,
        w = w,
        h = h,
        callback = callback,
        priority = priority or 0,
    })
end

function UI:IsPointInRect(point, x, y, w, h)
    return point.X >= x and point.X <= (x + w) and point.Y >= y and point.Y <= (y + h)
end

function UI:IsPointInMainWindow(point)
    local wx, wyBase = self:GetRenderWindowPosition()
    local wy = wyBase + self:GetAnimatedWindowYOffset()
    if self.windyMinimized then return (point.X-wx-26)^2+(point.Y-wy-26)^2<=26^2 end
    return self:IsPointInRect(point, wx, wy, self.window.width, self.window.height)
end

function UI:GetLoadingBounds()
    local showSidebar = self.loadingShowSidebar == true

    local contentW = tonumber(self.loadingContentWidth) or 450
    local sidebarW = tonumber(self.loadingSidebarWidth) or 250
    local windowW = tonumber(self.loadingWindowWidth) or 450

    local loadW = showSidebar and (contentW + sidebarW) or windowW
    local loadH = tonumber(self.loadingWindowHeight) or 275

    if self.loadingAutoResizeHeight then
        local innerContentHeight = 64 + 12 + 18 + 12 + 14 + 12 + 15
        local requiredContentHeight = 49 + 48 + innerContentHeight

        local sidebarItems = self.loadingSidebarItems or {}
        local requiredSidebarHeight = 49 + 18 + 18 + (#sidebarItems * 32) + 20

        loadH = math.max(self.loadingBaseWindowHeight or 275, requiredContentHeight, requiredSidebarHeight)
        self.loadingWindowHeight = loadH
    end

    local viewport = self:GetViewportSize()
    local loadX = math.floor((viewport.X - loadW) * 0.5)
    local loadY = math.floor((viewport.Y - loadH) * 0.5)

    return loadX, loadY, loadW, loadH, contentW, sidebarW
end

function UI:IsPointInLoadingWindow(point)
    local loadX, loadY, loadW, loadH = self:GetLoadingBounds()
    return self:IsPointInRect(point, loadX, loadY, loadW, loadH)
end

function UI:GetMouseLocation()
    local ok, pos = pcall(function()
        return UserInputService:GetMouseLocation()
    end)
    if ok and pos then
        return pos
    end

    if LocalMouse then
        return Vector2.new(LocalMouse.X or 0, LocalMouse.Y or 0)
    end

    return Vector2.new(0, 0)
end

function UI:TrimText(text)
    return tostring(text or ""):match("^%s*(.-)%s*$")
end

function UI:SetSearchText(text)
    text = tostring(text or "")

    if self.searchText == text then
        return
    end

    self.searchText = text
    self:UpdateSearch()
end

function UI:ClearSearch()
    self:SetSearchText("")
end

function UI:ControlMatchesSearch(control)
    local query = self:TrimText(self.searchText):lower()

    if query == "" then
        return true
    end

    if not control then
        return false
    end

    local haystack = table.concat({
        tostring(control.id or control.Idx or control.idx or ""),
        tostring(control.label or ""),
        tostring(control.Text or control.text or ""),
        tostring(control.description or ""),
        tostring(control.type or control.Type or ""),
        tostring(self:GetControlRawValue(control, "")),
    }, " "):lower()

    return string.find(haystack, query, 1, true) ~= nil
end

function UI:TabHasSearchMatch(tabIndex)
    if self.tabs[tabIndex] and self.tabs[tabIndex].hidden then return false end
    local tabControls = self.controls[tabIndex] or {}

    for _, control in ipairs(tabControls) do
        if self:IsControlVisible(control) and self:ControlMatchesSearch(control) then
            return true
        end
    end

    return false
end

function UI:GetFirstSearchMatchTab()
    for tabIndex, _ in ipairs(self.controls or {}) do
        if self:TabHasSearchMatch(tabIndex) then
            return tabIndex
        end
    end

    return nil
end

function UI:UpdateSearch()
    local query = self:TrimText(self.searchText)
    self.searching = query ~= ""
    self.scroll.offset = 0

    if not self.searching then
        self.lastSearchTab = nil
        self:MarkShellDirty()

        for tabIndex = 1, #self.controls do
            self:MarkTabDirty(tabIndex)
        end

        return
    end

    if self.globalSearch then
        local activeHasMatch = self:TabHasSearchMatch(self.selectedTab)
        local firstMatchTab = self:GetFirstSearchMatchTab()

        if firstMatchTab and not activeHasMatch then
            self.selectedTab = firstMatchTab
            self.expandedDropdown = nil
            self.contentAlpha = 0
            self.contentOffset = 6
        end

        self.lastSearchTab = nil
    else
        self.lastSearchTab = self.selectedTab
    end

    self:UpdateScrollLimit()
    self:MarkShellDirty()

    for tabIndex = 1, #self.controls do
        self:MarkTabDirty(tabIndex)
    end
end

function UI:GetSearchBounds()
    local wx, wyBase = self:GetRenderWindowPosition()
    local wy = wyBase + self:GetAnimatedWindowYOffset()
    local ww = self.window.width
    local sidebarW = self.window.sidebarWidth

    local searchX = wx + sidebarW + 12
    local searchY = wy + 9
    local searchRight = wx + ww - 14
    local searchW = searchRight - searchX
    local searchH = 34

    return searchX, searchY, searchW, searchH
end

function UI:IsPointInSearchBox(point)
    local x, y, w, h = self:GetSearchBounds()
    return self:IsPointInRect(point, x, y, w, h)
end

function UI:SetRobloxInputEnabled(enabled)
    if type(setrobloxinput) ~= "function" then
        return
    end

    local shouldDisable = enabled ~= true
    if self.robloxInputDisabled == shouldDisable then
        return
    end

    local ok = pcall(setrobloxinput, enabled == true)
    if ok then
        self.robloxInputDisabled = shouldDisable
    end
end

function UI:UpdateRobloxInputCapture()
    self:SetRobloxInputEnabled(self.uiVisible ~= true or self.windyMinimized == true)
end

function UI:FocusSearch()
    if self.searchFocused or self.activeTextInput or self.activeDropdownSearch or self.activeKeybind then
        return
    end

    self.activeTextInput = nil
    self.activeDropdownSearch = nil
    self.activeKeybind = nil
    self.expandedDropdown = nil
    self.expandedColorPicker = nil
    self.searchFocused = true
    self.searchCursor = true
    self.searchCursorTick = tick()
    self:ZeroSearchKeys()
    self:UpdateRobloxInputCapture()
    self:MarkShellDirty()
end

function UI:ZeroSearchKeys()
    for key in pairs(searchPrevKeys) do
        searchPrevKeys[key] = false
    end
end

function UI:BlurSearch()
    if not self.searchFocused then
        return
    end

    self.searchFocused = false
    self:ZeroSearchKeys()
    self:UpdateRobloxInputCapture()
    self:MarkShellDirty()
end

function UI:GetFocusedTextControl()
    if not self.activeTextInput then
        return nil, nil
    end

    local control, tabIndex = self:GetControlById(self.activeTextInput)
    if not control or self:IsControlDisabled(control) then
        self.activeTextInput = nil
        self:UpdateRobloxInputCapture()
        return nil, nil
    end

    local controlType = self:GetControlType(control)
    if controlType ~= "input" and controlType ~= "textbox" then
        self.activeTextInput = nil
        self:UpdateRobloxInputCapture()
        return nil, nil
    end

    return control, tabIndex
end

function UI:BlurActiveTextInput()
    if not self.activeTextInput then
        return
    end

    self.activeTextInput = nil
    self:ZeroSearchKeys()
    self:UpdateRobloxInputCapture()
    self:MarkCurrentTabDirty()
end

function UI:SetFocusedTextValue(text, control, tabIndex)
    control = control or self:GetFocusedTextControl()
    if not control then
        return
    end

    text = tostring(text or "")

    local maxLength = control.maxLength or control.MaxLength
    if maxLength and #text > maxLength then
        text = text:sub(1, maxLength)
    end

    if (control.numeric or control.Numeric) and text ~= "" and not tonumber(text) then
        return
    end

    if self:GetControlRawValue(control, "") == text then
        return
    end

    self:SetControlRawValue(control, text)
    self:RunAction(control, text)
    self:MarkTabDirty(tabIndex or self.selectedTab)
    if self:GetControlId(control) ~= "ai_prompt_input" then
        self:SaveConfig(false)
    end
end

function UI:RegisterSearchHitbox()
    local searchX, searchY, searchW, searchH = self:GetSearchBounds()

    self:RegisterHitbox("search_box", searchX, searchY, searchW, searchH, function()
        self:FocusSearch()
    end, 5)
end

function UI:PollSearchKeys()
    local focusedControl, focusedTab = self:GetFocusedTextControl()
    local dropdownSearchId = self.activeDropdownSearch
    local dropdownControl = nil
    if dropdownSearchId then
        dropdownControl = self:GetControlById(dropdownSearchId)
        if not dropdownControl or self.expandedDropdown ~= dropdownSearchId then
            self.activeDropdownSearch = nil
            dropdownControl = nil
        end
    end

    local typingSearch = self.searchFocused == true
    local typingInput = focusedControl ~= nil
    local typingDropdown = dropdownControl ~= nil

    if not typingSearch and not typingInput and not typingDropdown then
        self:UpdateRobloxInputCapture()
        return
    end

    self:UpdateRobloxInputCapture()

    if type(iskeypressed) ~= "function" then
        return
    end

    local function getFocusedText()
        if typingSearch then
            return tostring(self.searchText or "")
        elseif typingDropdown then
            return tostring(self.dropdownSearchText[dropdownSearchId] or "")
        end
        return tostring(self:GetControlRawValue(focusedControl, ""))
    end

    local function setFocusedText(text)
        if typingSearch then
            self:SetSearchText(text)
        elseif typingDropdown then
            self.dropdownSearchText[dropdownSearchId] = tostring(text or "")
            self:UpdateScrollLimit()
            self:MarkCurrentTabDirty()
        else
            self:SetFocusedTextValue(text, focusedControl, focusedTab)
        end
    end

    local now = tick()
    if now - (self.searchCursorTick or 0) > 0.53 then
        self.searchCursor = not self.searchCursor
        self.searchCursorTick = now
        if typingSearch then
            self:MarkShellDirty()
        end
        if typingInput then
            self:MarkCurrentTabDirty()
        end
        if typingDropdown then
            self:MarkCurrentTabDirty()
        end
    end

    local shift = false
    pcall(function()
        shift = iskeypressed(VK.SHIFT) == true
    end)

    local escDown = false
    pcall(function()
        escDown = iskeypressed(VK.ESCAPE) == true
    end)

    if escDown and not searchPrevKeys[VK.ESCAPE] then
        if typingSearch then
            self:BlurSearch()
        end
        if typingInput then
            self:BlurActiveTextInput()
        end
        if typingDropdown then
            self.activeDropdownSearch = nil
            self.expandedDropdown = nil
            self:UpdateRobloxInputCapture()
            self:UpdateScrollLimit()
            self:MarkCurrentTabDirty()
        end
    end
    searchPrevKeys[VK.ESCAPE] = escDown

    local enterDown = false
    pcall(function()
        enterDown = iskeypressed(VK.RETURN) == true
    end)

    if enterDown and not searchPrevKeys[VK.RETURN] then
        if typingSearch then
            self:BlurSearch()
        end
        if typingInput then
            if self:GetControlId(focusedControl) == "ai_prompt_input" then
                self:SendAIMessage()
            else
                self:BlurActiveTextInput()
            end
        end
        if typingDropdown then
            self.activeDropdownSearch = nil
            self.expandedDropdown = nil
            self:UpdateRobloxInputCapture()
            self:UpdateScrollLimit()
            self:MarkCurrentTabDirty()
        end
    end
    searchPrevKeys[VK.RETURN] = enterDown

    local backDown = false
    pcall(function()
        backDown = iskeypressed(VK.BACK) == true
    end)

    now = tick()

    if backDown then
        if not searchPrevKeys[VK.BACK] then
            self.searchBackspaceStartedAt = now
            self.searchBackspaceNextAt = now + (self.searchBackspaceDelay or 0.35)

            local text = getFocusedText()
            if #text > 0 then
                setFocusedText(text:sub(1, -2))
            end

        elseif self.searchBackspaceNextAt and now >= self.searchBackspaceNextAt then
            local text = getFocusedText()
            if #text > 0 then
                setFocusedText(text:sub(1, -2))
            end

            self.searchBackspaceNextAt = now + (self.searchBackspaceRate or 0.045)
        end
    else
        self.searchBackspaceStartedAt = nil
        self.searchBackspaceNextAt = nil
    end

    searchPrevKeys[VK.BACK] = backDown

    local delDown = false
    pcall(function()
        delDown = iskeypressed(VK.DELETE) == true
    end)

    if delDown and not searchPrevKeys[VK.DELETE] then
        setFocusedText("")
    end
    searchPrevKeys[VK.DELETE] = delDown

    for vk, chars in pairs(VKCHARS) do
        local down = false
        pcall(function()
            down = iskeypressed(vk) == true
        end)

        if down and not searchPrevKeys[vk] then
            local char = shift and chars[2] or chars[1]
            setFocusedText(getFocusedText() .. char)
        end

        searchPrevKeys[vk] = down
    end
end

function UI:PollKeybindCapture()
    if not self.activeKeybind or self.searchFocused or self.activeTextInput or self.activeDropdownSearch then
        return
    end

    if type(iskeypressed) ~= "function" then
        return
    end

    local control = self:GetControlById(self.activeKeybind)
    if not control or self:IsControlDisabled(control) then
        self.activeKeybind = nil
        self:UpdateRobloxInputCapture()
        self:MarkCurrentTabDirty()
        return
    end

    for _, keyCode in ipairs(VK_CAPTURE_ORDER) do
        local down = false
        pcall(function()
            down = iskeypressed(keyCode) == true
        end)

        if down and not keybindPrevKeys[keyCode] then
            if keyCode == VK.ESCAPE then
                self.activeKeybind = nil
                self:UpdateRobloxInputCapture()
                self:MarkCurrentTabDirty()
            elseif keyCode == VK.BACK or keyCode == VK.DELETE then
                self:SetControlRawValue(control, "None")
                self.activeKeybind = nil
                self:UpdateRobloxInputCapture()
                self:RunAction(control, "None")
                self:MarkCurrentTabDirty()
                self:SaveConfig(false)
            else
                local keyName = VK_NAMES[keyCode] or tostring(keyCode)
                self:SetControlRawValue(control, keyName)
                self.activeKeybind = nil
                self:UpdateRobloxInputCapture()
                self:RunAction(control, keyName)
                self:MarkCurrentTabDirty()
                self:SaveConfig(false)
            end
        end

        keybindPrevKeys[keyCode] = down
    end
end

