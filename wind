function UI:DrawWindyScrollbar(bucket)
 if self.scroll.max<=0 or self.windyMinimized or self.windyMorph then return end
 local wx,wy=self:GetRenderWindowPosition()
 wy+=self:GetAnimatedWindowYOffset()
 local _,contentY,_,height=self:GetContentBounds()
 local x=wx+self.window.width-18
 local y=math.max(wy+8,contentY+8)
 local bottom=math.min(wy+self.window.height-14,contentY+height-8)
 local h=math.max(1,bottom-y)
 local thumbH=math.min(h,math.max(34,math.floor(h*height/(height+self.scroll.max))))
 local travel=math.max(0,h-thumbH)
 local thumbY=y+travel*math.clamp(self.scroll.offset/self.scroll.max,0,1)
 if bucket then
  local previous=self.drawingClip
  self:SetDrawingClip(wx,wy,self.window.width,self.window.height)
  self:CreateRoundedBox(bucket,x,y,3,h,1,Theme.borderSoft,1)
  self:CreateRoundedBox(bucket,x,thumbY,3,thumbH,1,Theme.accent,1)
  self.drawingClip=previous
 end
 self:RegisterHitbox("scrollbar_thumb",x-5,thumbY,13,thumbH,function()
  self.draggingScroll=true;self.scrollDragOffset=self:GetMouseLocation().Y-thumbY
 end,3)
end
