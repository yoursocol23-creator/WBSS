["Windy-1.matcha.geometry.luau"]=[==[local Geometry = {}

-- Inclusive intersection of a finite segment with an oriented part box.
-- Returns entry and exit fractions in [0,1], or nil when there is no hit.
-- A WedgePart is conservatively represented by its bounding box.
function Geometry.SegmentBox(origin,target,frame,size)
 local first=frame:PointToObjectSpace(origin)
 local last=frame:PointToObjectSpace(target)
 local near,far=0,1
 for _,axis in ipairs({"X","Y","Z"}) do
  local half=math.abs(size[axis])/2
  local position,delta=first[axis],last[axis]-first[axis]
  if math.abs(delta)<1e-10 then
   if position < -half or position > half then return nil end
  else
   local enter,leave=(-half-position)/delta,(half-position)/delta
   if enter>leave then enter,leave=leave,enter end
   near=math.max(near,enter)
   far=math.min(far,leave)
   if near>far then return nil end
  end
 end
 return near,far
end

return Geometry
