    local title=self:WindyCardTitle(control,name)
    local group=lookup[title]
    if not group then
     local side=heights[1]<=heights[2]and 1 or 2
     group={name=title,controls={}};lookup[title]=group;table.insert(columns[side],group)
     heights[side]+=1
    end
    table.insert(group.controls,control)
