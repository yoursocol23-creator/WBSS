 function backend:ResolveNPCQuest(npc)
  local value=npc:FindFirstChild("NPC")
  local name=value and value.Value or npc.Name
  local index=self.stats:ReadPath({"NPCs",name,"Event"})
  local phase=self.stats:ReadPath({"NPCs",name,"Phase"})
  if type(index)~="number"then return nil end
  local stats=self:QuestStats()
  local quests=stats.Quests
  for _=1,20 do
   local event=self:NPCEvent(name,index)
   if not event then return nil end
   local active
   for _,record in ipairs(quests.Active)do
    local definition=self.questApi.Get(nil,record.Name)
    if event.Type=="Single Quest"and record.Name==event.Quest or event.Type=="Repeat Quest"and definition and definition.Pool==event.QuestPool then active=record;break end
   end
   if event.Type=="Single Quest"and table.find(quests.Completed,event.Quest)then
    index+=1
   elseif event.Type=="Single Quest"or event.Type=="Repeat Quest"then
    if active then
     local progress=self.questApi.Progress(nil,active.Name,stats)
     if not progress or #progress==0 then
      if phase~="Finish"then return nil end
     else for _,task in ipairs(progress)do
      if task.unsupported then if phase~="Finish"then return nil end
      elseif task[1]<1 then return nil end
     end end
     phase="Finish"
    elseif phase=="Unready"then return nil
    elseif event.Type=="Repeat Quest"then
     local cooldown=self:PoolCooldown(event.QuestPool)
     if cooldown==nil then
      if phase=="Cooldown"then return nil end
     elseif cooldown>0 then
      local last=quests.PoolTimers and tonumber(quests.PoolTimers[event.QuestPool])or 0
      if host.os.time()-last<cooldown then return nil end
     end
     phase="Start"
    elseif phase=="Cooldown"then return nil
    else phase="Start"end
    local pooled=event.Type=="Repeat Quest"
    local command=phase=="Finish"and(pooled and"CompleteQuestFromPool"or"CompleteQuest")or(pooled and"GiveQuestFromPool"or"GiveQuest")
    return {name=name,index=index,phase=phase,command=command,argument=pooled and event.QuestPool or event.Quest}
   else return nil end
  end
  return nil
