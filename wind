    end
   end)
   if self.job==job then self:Stop(ok and "hover finished"or "hover error")end
   if not ok then host.warn("[Windy combat hover]",reason)end
  end)
  return true
 end
 function service:Destroy()self:Stop("destroyed");self.closed=true end
 return service
end
