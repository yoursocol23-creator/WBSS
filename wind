["Windy-1.matcha.fields.luau"]=[==[-- Reproduce Windy's upward field ray using the real field boxes.
-- Matcha's raycast does not hit Bee Swarm's non-collidable FlowerZones.
return function(host,instances)
 local geometries,last={},-math.huge
 local function coordinates(point)
  local kind=type(point)
  if kind~="table"and kind~="userdata"and kind~="vector"then return nil end
  local x,y,z=point.X,point.Y,point.Z
  if type(x)~="number"or type(y)~="number"or type(z)~="number"then return nil end
  if x~=x or y~=y or z~=z or math.abs(x)==math.huge or math.abs(y)==math.huge or math.abs(z)==math.huge then return nil end
  return x,y,z
 end
 local function refresh()
  geometries={}
  for _,field in host.workspace.FlowerZones:GetChildren()do
   if field.ClassName=="Part"then
    local frame,size=field.CFrame,field.Size
    geometries[#geometries+1]={object=field,frame=frame,size=size,center=frame.Position,radiusSquared=(size.X*size.X+size.Y*size.Y+size.Z*size.Z)/4}
   end
  end
  last=host.os.clock()
 end
 return function(point)
  local px,py,pz=coordinates(point)
  if px==nil then return nil end
  if host.os.clock()-last>10 then refresh()end
  local closest,nearest=nil,math.huge
  for _,field in geometries do
   -- A conservative sphere rejects distant zones before native CFrame calls.
   if field.center then
    local cx,_,cz=coordinates(field.center)
    if cx==nil then continue end
    local dx,dz=px-cx,pz-cz
    if dx*dx+dz*dz>field.radiusSquared then continue end
   end
   local origin=field.frame:PointToObjectSpace(host.Vector3.new(px,py-35,pz))
   local direction=field.frame:VectorToObjectSpace(host.Vector3.new(0,50,0))
   local near,far=0,1
   for _,axis in {"X","Y","Z"}do
    local half=field.size[axis]/2
    local position,delta=origin[axis],direction[axis]
    if math.abs(delta)<1e-8 then
     if math.abs(position)>half then near=2;break end
    else
     local a,b=(-half-position)/delta,(half-position)/delta
     if a>b then a,b=b,a end
     near=math.max(near,a);far=math.min(far,b)
     if near>far then break end
    end
   end
   if near<=far and near<nearest then nearest=near;closest=field.object end
  end
  return closest and instances.wrap(closest)or nil
 end
end
