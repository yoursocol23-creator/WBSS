									equipAccessory(cfg.convert.defaultMask)
								end
							end

							if getFieldAt(getRootPart().Position) ~= field then
								goTo(position2, field.Name)
							end

							if cfg.combat.avoidmobs then
								getAggroMobs()
							end

							if cfg.face.shiftlock then
								input:handleShiftLock(true)
							end

							reportStatus(3)
							farmStep(farmOptions)
							continue
						end
					else
						if shouldConvert() then
							convertHoney()
						end

						continue
					end

					break
				end
			end

			if exitTo ~= 1 then
				farmPuffshroom(v119)
				return
			end

			if os.clock() - now >= 300 then
				tracked.puffshrooms[puffshroom] = nil
			else
				farmFor(farmOptions, puffRarity ~= "Common" and puffRarity ~= "Rare" and 14 or 8, puffRarity ~= "Common" and puffRarity ~= "Rare" and 6 or 2)
			end
		elseif shouldConvert() then
			convertHoney()
		end
	end

	error("return", 0)
