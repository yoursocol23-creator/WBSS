					if not constraints.avoid and (constraints.origin - vector5).Magnitude < constraints.range then
						return vector5
					end
					continue
				end

				if not isPathClear(vector5, constraints.avoid, true, constraints.rbc) then
					return vector5
				end

				if not constraints.avoid and (constraints.origin - vector5).Magnitude < constraints.range then
					break
				end
			end
		end

		return vector5
	end

