 function backend:WalkJumpTo(target)
  local player=host.game:GetService("Players").LocalPlayer
  local char=player.Character
  local root=char and char:FindFirstChild("HumanoidRootPart")
  local hum=char and char:FindFirstChild("Humanoid")
  assert(root and hum and hum.Health>0,"No live character for path jump")
  local walking=runtime.instances.walking
  walking:Stop("preparing platform jump")
  local function check()
   assert(player.Character and player.Character.Address==char.Address and hum.Health>0,"Path jump character changed")
  end
  local ok,reason=pcall(function()
   local began=host.os.clock()
   while not self:PathJump()do
    check();assert(host.os.clock()-began<3,"Path jump was not ready");env.task.wait(.05)
   end
   local launchY=root.Position.Y
   -- Allow a game frame to observe the impulse before preserving Y while steering.
   env.task.wait(.05)
   check()
   self.lastPlatformJump={target=target,fromY=launchY,launchVelocity=root.AssemblyLinearVelocity.Y}
   assert(root.AssemblyLinearVelocity.Y>5 or root.Position.Y>launchY+1,"Platform jump impulse did not start")
   began=host.os.clock()
   while host.os.clock()-began<3 do
    check()
    local p,v=root.Position,root.AssemblyLinearVelocity
    local dx,dz=target.X-p.X,target.Z-p.Z
    local distance=math.sqrt(dx*dx+dz*dz)
    if distance<2 and math.abs(p.Y-target.Y)<4 and math.abs(v.Y)<2 and host.os.clock()-began>.15 then return end
    assert(p.Y>=math.min(launchY,target.Y)-8,"Platform jump fell below its landing")
