   local origin=root.Position
   local duration=(target-origin).Magnitude/math.max(1,tonumber(speed)or 60)
   local started=host.os.clock()
   while self.job==job and self.generation==generation do
    local char=player.Character
    assert(char and char.Address==job.character and root.Address==job.root and humanoid.Health>0,"character changed")
    local elapsed=host.os.clock()-started
    assert(elapsed<=math.min(duration+2,30),"timeout")
