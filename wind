inventory.Has = function(owner, required, v63, v64)
 local direct=WindyMatchaBackend:HasToyPasses(required)
 if direct~=nil then return direct end
	for k, requirement in pairs(required) do
		local timeKey = requirement == "lessthan10" and k .. "lessthan10" or k
		if not owner.time[timeKey] then
			continue
		end
		local lastCheck = owner.time[timeKey]
		if not (os.clock() - lastCheck < 30) then
			continue
		end
		return
	end

	local ownedItems = owner:Fetch(v63, v64)

	if not ownedItems then
		for k in pairs(required) do
			owner.time[k] = os.clock()
		end

		return
	end

	local hasAll = true

	for k, neededAmount in pairs(required) do
		if neededAmount == "lessthan10" then
			if (ownedItems[k] or 0) >= 10 then
				owner.time[k .. "lessthan10"] = os.clock()
				hasAll = nil
				continue
			end
		end

		if neededAmount ~= "lessthan10" then
			if (ownedItems[k] or 0) < neededAmount then
				owner.time[k] = os.clock()
				hasAll = nil
			end
		end
	end

	return hasAll
end

