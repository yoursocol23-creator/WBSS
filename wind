						while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
							RunService.Heartbeat:Wait()
						end

						task.wait(0.15)
					end

					matchedFlags[pairA[2]] = true
					matchedFlags[pairB[2]] = true
				end
			end

			local now2 = os.clock()

			while not (not gameGui.MinigameLayer.Visible or not (os.clock() - now2 < 6)) do
