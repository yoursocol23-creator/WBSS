 local balloonChildren=setmetatable({},{__mode="k"})
 backend.balloonOverlapMetrics={updates=0,childScans=0,expired=0,samples=0}
 function backend:BalloonOverlap(tracked,owner,field,getField)
  local samples={}
  local now=host.os.clock()
  local count=0
  self.balloonOverlapMetrics.updates+=1
  for balloon in pairs(tracked)do
   if not balloon.Parent then
    tracked[balloon]=nil;balloonChildren[balloon]=nil
    self.balloonOverlapMetrics.expired+=1
    continue
   end
   local cached=balloonChildren[balloon]
   local complete=cached and cached.body and cached.owner and cached.body.Parent and cached.owner.Parent
   if not cached or(not complete and now-cached.checked>=.5)then
    cached={checked=now};balloonChildren[balloon]=cached
    -- Never use native FindFirstChild here: the captured VM stall was inside
    -- that binding on Balloon34377. Enumerate once, not inside every pair.
    local children=balloon:GetChildren()
    self.balloonOverlapMetrics.childScans+=1
    for _,child in ipairs(children)do
     if child.Parent then
      if child.Name=="BalloonBody"then cached.body=child
      elseif child.Name=="PlayerName"then cached.owner=child end
     end
    end
   end
   if cached.body and cached.owner and cached.body.Parent and cached.owner.Parent and cached.owner.Value==owner then
    local point=self:TargetPosition(cached.body)
    if point and getField(point)==field then
     -- The overlap task publishes coordinates, so the farm loop cannot read
     -- a destroyed native part between this update and its next token check.
     samples[#samples+1]={Name=true,Position=point}
    end
   end
   count+=1
   if count%16==0 then env.task.wait()end
  end
  self.balloonOverlapMetrics.samples=#samples
  local best={}
  for i,center in ipairs(samples)do
   local group={}
   for _,candidate in ipairs(samples)do
    if(center.Position-candidate.Position).Magnitude<10 then group[#group+1]=candidate end
   end
   -- Preserve the original first-largest-group selection on ties.
   if #group>#best then best=group end
   if i%16==0 then env.task.wait()end
  end
  return best
 end
