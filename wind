local function destroyTotems()
	for k in pairs(tracked.totems) do
		local Part = k:FindFirstChild("Part")

		if Part then
			local field = getFieldAt(Part.Position)

			if field then
				setField(field.Name)
				local now = os.clock()

				while not (not Part.Parent or not Part.Parent.Parent or not (os.clock() - now < 180)) do
					if not RunService.Heartbeat:Wait() then
						break
					end

					if not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
						goToField()

						if cfg.combat.avoidmobs then
							getAggroMobs()
						end

						if not (not cfg.autofarm.autosprinkler or farmState.field == field.Name) then
							farmState:Handle()
						end

						if cfg.face.shiftlock then
							input:handleShiftLock(true)
						end

						if field.Name ~= "Mountain Top Field" or not tracked.mondo then
							farmStep({ skipoverlap = true })
						else
							handleMondoChick(true)
						end
					elseif shouldConvert() then
						convertHoney()
					end
				end

				if cfg.stickbug.loot then
					local now2 = os.clock()

					while os.clock() - now2 < 6 do
						if not RunService.Heartbeat:Wait() then
							break
						end
						goToField()
						farmStep({ loot = true, loot2 = true })
					end
				end
			end
		end
	end
end

