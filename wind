			walkTo(position2, true, 10)

			if not (not cfg.autofarm.autosprinkler or farmState.field == field.Name) then
				farmState:Place({ position2 })
				farmState.field = field.Name
			end

			local farmOptions = { loot = true, origin = position2, range = 25 }
			local now = os.clock()
			local exitTo = nil

			while true do
				if not puffshroom.Parent or not (os.clock() - now < 300) then
					exitTo = 1
					break
				else
					if not RunService.Heartbeat:Wait() then
						exitTo = 1
						break
					elseif not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
						if not findPuffshroom(v119, puffshroom, puffRarity) then
							if not (not cfg.convert.autoHoneyMask and not cfg.combat.demonmask or not (WindyMatchaBackend:IsTweenMovement(cfg.vars.movement) or cfg.convert.defaultMask ~= "Demon Mask")) then
