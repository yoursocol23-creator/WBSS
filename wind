	memoryMatch = {
		blacklist = {},
		Get = function(tiles, matchedFlags, imageId, targetCount, requireFlipped)
			local firstMatch = nil
			local secondMatch = nil
			local matchCount = 0

			for i, tile in ipairs(tiles) do
				if not matchedFlags[i] then
					local objCard = tile.StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
					local TextCount = objCard.ObjContent.ObjImage:FindFirstChild("TextCount")

					if TextCount then
						local tonumber_ = tonumber
						local countText = string.gsub(objCard.ObjContent.ObjImage.TextCount.Text, "x", "")
						TextCount = tonumber_(countText)
					end

					TextCount = TextCount or 1
					local cardImageId = string.match(objCard.ObjContent.ObjImage.Image, "%d+")

					if imageId ~= "3690982763" then
						if imageId == cardImageId then
							if targetCount == TextCount then
								if not requireFlipped or objCard.ObjBorder.Visible then
									matchCount += 1

									if not firstMatch then
										firstMatch = { tile, i }
									else
										secondMatch = { tile, i }
										break
									end
								end
							end
						end
					end
				end
			end

			return matchCount, firstMatch, secondMatch
		end,
		Do = function(matcher, gameFrame, slotFrame, tileList)
			local countLabel = gameFrame.ChancesFrame.CountLabel
			local attempts = 0
			local matchedFlags = {}

			for _, tile in ipairs(tileList) do
				local objCard = tile.StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
				local TextCount = objCard.ObjContent.ObjImage:FindFirstChild("TextCount")

				if TextCount then
					local tonumber_ = tonumber
					local countText = string.gsub(objCard.ObjContent.ObjImage.TextCount.Text, "x", "")
					TextCount = tonumber_(countText)
				end

				TextCount = TextCount or 1
				local cardImageId = string.match(objCard.ObjContent.ObjImage.Image, "%d+")

				if cardImageId ~= "3690982763" then
					local matchCount, firstMatch, secondMatch = matcher.Get(tileList, matchedFlags, cardImageId, TextCount, true)

					if matchCount == 2 then
						matchedFlags[firstMatch[2]] = true
						matchedFlags[secondMatch[2]] = true
					end
				end
			end

			local now = os.clock()
			local matchGame = debug.getupvalue(gameApi.MemoryMatchManager, 2)
			if not matchGame then
				logger.warn("Active memory match game is nil")
				return
			end

			while not matchGame.Grid.InputActive and os.clock() - now < 4 do
				RunService.Heartbeat:Wait()
			end

			while not (not (attempts < 20) or countLabel.Text == "0" or not (#tileList > 0)) do
				attempts += 1
				local pairA = nil
				local pairB = nil
				local skipTiles = {}

				for i, tile in ipairs(tileList) do
					if not matchedFlags[i] then
						local objCard = tile.StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
						local TextCount = objCard.ObjContent.ObjImage:FindFirstChild("TextCount")

						if TextCount then
							local tonumber_ = tonumber
							local countText = string.gsub(objCard.ObjContent.ObjImage.TextCount.Text, "x", "")
							TextCount = tonumber_(countText)
						end

						TextCount = TextCount or 1
						local cardImageId = string.match(objCard.ObjContent.ObjImage.Image, "%d+")

						if cardImageId ~= "3690982763" then
							local matchCount, firstMatch, secondMatch = matcher.Get(tileList, matchedFlags, cardImageId, TextCount, false)

							if countLabel.Text == "1" or not (matchCount == 1 or matcher.blacklist[cardImageId]) then
								if matchCount == 2 then
									pairA = firstMatch
									pairB = secondMatch
								end
							else
								skipTiles[tile] = true
							end
						end
					end
				end

				if not pairA or not pairB then
					local randomIndex = math.random(#tileList)
					local randomTile = tileList[randomIndex]
					local retries = 0

					while not (not skipTiles[randomTile] and not matchedFlags[randomIndex]) do
						if retries > 100 then
							error("return", 0)
						end

						retries += 1
						randomIndex = math.random(#tileList)
						randomTile = tileList[randomIndex]
					end

					local now2 = os.clock()
					secureCall(gameApi.MemoryMatch, matchGame, secureCall(matchGame.Grid.GetTileAtIndex, matchGame.Grid, randomIndex))

					while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
						RunService.Heartbeat:Wait()
					end

					task.wait(0.15)
				else
					local objCard = pairA[1].StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
					local objCard2 = pairB[1].StageGrow.StagePop.StageFlip.ObjCard.ObjContent.GuiTile.StageGrow.StagePop.StageFlip.ObjCard
					local now2 = os.clock()

					if not objCard.ObjBorder.Visible then
						secureCall(gameApi.MemoryMatch, matchGame, secureCall(matchGame.Grid.GetTileAtIndex, matchGame.Grid, pairA[2]))

						while not matchGame.Grid.InputActive and not matchGame.Finished and os.clock() - now2 < 2 do
							RunService.Heartbeat:Wait()
