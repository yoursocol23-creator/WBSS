	local function findFirefly(recentlySeen)
		local closestFirefly = nil

		for k in pairs(tracked.fireflies) do
			local seenClock = recentlySeen and recentlySeen[k]

			if not seenClock or os.clock() - seenClock > 2 then
				local BodyVelocity = k:FindFirstChild("BodyVelocity")

				if WindyMatchaBackend:FireflyReady(k) then
					local distance = distanceTo(k.Position)

					if not closestFirefly or distance < closestFirefly.d then
						closestFirefly = { d = distance, v = k }
					end
				end
			end
		end

		return closestFirefly and closestFirefly.v
	end

