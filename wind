 function backend:PrepareQuestTasks(object,definition,tasks)
  local field=self.stats:FieldAddress(object,"Tasks")
  local native=field and host.memory_read("int",field+12)==7 and host.memory_read("uintptr",field)
  local array=native and host.memory_read("uintptr",native+24)
  local size=native and host.memory_read("int",native+8)or 0
  for index,task in ipairs(tasks)do
   if array and index<=size then
    local address=array+(index-1)*16
    if host.memory_read("int",address+12)==7 then
     local pointer=host.memory_read("uintptr",address)
     local amount=self.stats:FieldAddress(pointer,"Amount")
     if amount and host.memory_read("int",amount+12)==8 then
      task.__WindyDynamicAmount=true
      task.__WindyAmount=self:QuestAmountParameters(host.memory_read("uintptr",amount))
     end
    end
   end
   if type(task.Description)~="string"then
    task.Description=function(stats)
     local rows=self:QuestGuiTasks(definition)
     local row=rows and rows[index]
     return row and row.text or self.questTaskTypes.Describe(task,stats,definition)
