 function backend:NativeUpvalue(exportName,index)
  local records=self.nativeHandles[exportName]
  if not records then
   records={}
   for _,entry in host.getgc(exportName)do if entry.key==exportName and entry.vtt==8 then records[#records+1]=entry.addr end end
   self.nativeHandles[exportName]=records
  end
  assert(#records==1,"Ambiguous native game function: "..exportName)
  local closure=host.memory_read("uintptr",records[1])
  assert(index<host.memory_read("byte",closure+5),"Native upvalue index changed: "..exportName)
  local address=closure+32+index*16
  if host.memory_read("int",address+12)==16 then address=host.memory_read("uintptr",host.memory_read("uintptr",address)+8)end
  local tag=host.memory_read("int",address+12)
  if tag==0 then return nil end
  assert(tag==7,"Native upvalue is not a data table: "..exportName)
  return self.stats:ReadObject(host.memory_read("uintptr",address))
 end
 local function upvaluePointer(closure,index)
  assert(index<host.memory_read("byte",closure+5),"Native function capture layout changed")
  local address=closure+32+index*16
  if host.memory_read("int",address+12)==16 then address=host.memory_read("uintptr",host.memory_read("uintptr",address)+8)end
  assert(host.memory_read("int",address+12)==7,"Expected a native data table")
  return host.memory_read("uintptr",address)
 end
