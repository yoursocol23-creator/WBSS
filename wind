function UI:ApplyWorldNoCollideOnce()
    local set = 0
    self.worldNoCollideParts = self.worldNoCollideParts or {}

    local function disablePart(part)
        if part and part:IsA("BasePart") then
            pcall(function()
                self.worldNoCollideParts[part] = true
                part.CanCollide = false
                set = set + 1
            end)
        end
    end

    local function disableTree(root)
        if not root then return end
        disablePart(root)
        for _, descendant in ipairs(root:GetDescendants()) do
            disablePart(descendant)
        end
    end

    local function disableNamedChildren(parent, name)
        if not parent then return end
        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == name then
                disableTree(child)
            end
        end
    end

    local decorations = workspace:FindFirstChild("Decorations")
    local misc = decorations and decorations:FindFirstChild("Misc")
    local treatMachine = misc and misc:FindFirstChild("TreatMachine")
    local gumballMachine = treatMachine and treatMachine:FindFirstChild("Gumball Machine")
    disablePart(gumballMachine and gumballMachine:FindFirstChild("Part"))

    local jumpGames = decorations and decorations:FindFirstChild("JumpGames")
    if jumpGames then
        for _, mushroom in ipairs(jumpGames:GetDescendants()) do
            if mushroom.Name == "Mushroom" then
                for _, child in ipairs(mushroom:GetChildren()) do
                    if child.Name == "Part" then
                        disablePart(child)
                    end
                end
            end
        end
    end

    local miscMushroom = misc and misc:FindFirstChild("Mushroom")
    disablePart(miscMushroom and miscMushroom:FindFirstChild("Part"))

    for _, flowerName in ipairs({
        "Blue Flower 1",
        "Blue Flower 2",
        "Blue Flower 3",
        "Blue Flower 4",
        "Blue Flower 6",
    }) do
        disableTree(misc and misc:FindFirstChild(flowerName))
    end
    disableNamedChildren(misc, "Bamboo")

    local fieldDecos = workspace:FindFirstChild("FieldDecos")
    disableNamedChildren(fieldDecos, "strawberry")
    disableNamedChildren(fieldDecos, "Cactus")
    disableNamedChildren(fieldDecos, "Pumpkin")
    disableNamedChildren(fieldDecos, "Pineapple")

    local gates = workspace:FindFirstChild("Gates")
    disableTree(gates and gates:FindFirstChild("15 Bee Gate"))

    return set > 0
end

