				local stepCount = string.match(moveString, "%d+%.?%d*") or 1

				string.gsub(directions, ".", function(direction)
					if startCorner == 2 then
						target += Vector3.new((direction == "E" and -stepCount or direction == "W" and stepCount or 0) * stepSize, 0, (direction == "N" and -stepCount or direction == "S" and stepCount or 0) * stepSize)
					elseif startCorner ~= 3 then
