    root.AssemblyLinearVelocity=host.Vector3.new(dx*scale,v.Y,dz*scale)
    env.task.wait(.05)
   end
   assert(false,"Platform jump did not land")
  end)
  walking:Stop("platform jump ended")
  if player.Character and player.Character.Address==char.Address and hum.Health>0 then
   local v=root.AssemblyLinearVelocity
   root.AssemblyLinearVelocity=host.Vector3.new(0,v.Y,0)
