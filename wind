 function backend:WalkGap(target,jump)
  local player=host.game:GetService("Players").LocalPlayer
  local char=player.Character
  local root=char and char:FindFirstChild("HumanoidRootPart")
  local nativeHum=char and char:FindFirstChild("Humanoid")
  assert(root and nativeHum and nativeHum.Health>0,"return")
  local humanoid=runtime.instances.wrap(nativeHum)
  local name=self.stats:ReadPath("EquippedParachute")
  assert(name and name~="None","This walking route requires an equipped glider")
  local spec=self:GliderStats(name)
