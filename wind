  -- destination surface before handing control back to the walking graph.
  local settled=host.os.clock()
  while host.os.clock()-settled<2 do
   assert(nativeHum.Health>0 and player.Character and player.Character.Address==char.Address,"return")
   local p,v=root.Position,root.AssemblyLinearVelocity
   assert(p.Y>=target.Y-8,"Missed the destination surface")
   if math.abs(v.Y)<1.5 and math.abs(p.Y-target.Y)<6 then return true end
