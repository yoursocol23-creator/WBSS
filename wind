  if self.closed then return false,"destroyed"end
  local character=player.Character
  local live=character and character:FindFirstChild("HumanoidRootPart")
  local humanoid=character and character:FindFirstChild("Humanoid")
  if not live or live.Address~=root.Address or not humanoid or humanoid.Health<=0 then return false,"character changed"end
  if (root.Position-target).Magnitude>10 then return false,"hold destination is too far away"end
  self:Stop("hover start")
  if walking then walking:Stop("combat hover")end
  local job={character=character.Address,root=root.Address,collisions={},holding=true}
  self.job=job
  host.task.spawn(function()
   if self.job~=job or self.closed then return end
   local ok,reason=pcall(function()
    suspendEvaluation(job,humanoid)
