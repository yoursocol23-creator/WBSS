 function backend:QuestDefinition(name)
  if type(name)~="string"then return nil end
  self.questDefinitionCache=self.questDefinitionCache or{}
  if self.questDefinitionCache[name]then return self.questDefinitionCache[name]end
  if not self.questDefinitions then
   local seen={}
   for _,entry in self:QuestFunctionRecords()do
    if entry.key=="NameToID"and entry.vtt==8 then
     local closure=host.memory_read("uintptr",entry.addr)
     if not seen[closure]then
      seen[closure]=true
      local ok,pointer=pcall(upvaluePointer,closure,0)
      if ok and self.stats:ReadObjectPath(pointer,{name,"Name"})==name then self.questDefinitions=pointer;break end
     end
    end
   end
   assert(self.questDefinitions,"Live quest definitions were not found")
  end
  local address=self.stats:FieldAddress(self.questDefinitions,name)
  if not address or host.memory_read("int",address+12)~=7 then return nil end
  local object=host.memory_read("uintptr",address)
  local definition={}
  for _,key in {"Name","NPC","Pool","DisplayName","Hidden","Repeatable","Theme"}do
   definition[key]=self.stats:ReadObjectPath(object,{key})
  end
  -- Rewards/requirements may contain large shared game tables. Claiming only
  -- needs this metadata; decode task counters once, on demand, for Auto Quest.
  local tasksRead=false
  setmetatable(definition,{__index=function(_,key)
   if key=="Tasks"and not tasksRead then
    tasksRead=true
    local tasks=self.stats:ReadObjectPath(object,{"Tasks"})
    if tasks then tasks=self:PrepareQuestTasks(object,definition,tasks);rawset(definition,"Tasks",tasks)end
    return tasks
   end
  end})
  self.questDefinitionCache[name]=definition
