 function service:MoveTo(root,target,speed)
  if self.closed then return false,"destroyed"end
  self:Stop("retargeted")
  if walking then walking:Stop("tween travel")end
  local character=player.Character
  local live=character and character:FindFirstChild("HumanoidRootPart")
  local humanoid=character and character:FindFirstChild("Humanoid")
  if not live or live.Address~=root.Address or not humanoid or humanoid.Health<=0 then return false,"character changed"end
  if not target or target.X~=target.X or target.Y~=target.Y or target.Z~=target.Z then return false,"invalid destination"end
