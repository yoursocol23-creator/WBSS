function UI:WindyCardTitle(control,section)
 local label=control.label or ""
 if section=="Farm Settings"then
  if label:find("Star")or label:find("Scorching")or label:find("X%-Flame")then return "Star abilities"end
  if label:find("Token")or label:find("Combo")or label:find("Smiley")then return "Tokens & combos"end
  if label:find("Precise")or label:find("Position")or label:find("Marks")then return "Precision & positioning"end
