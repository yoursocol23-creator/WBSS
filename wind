function UI:WindySectionWidth(name,available)
 local title=self:WindyGroupTitle(name)
 self.windyTextWidths=self.windyTextWidths or{}
 local measured=self.windyTextWidths[title]
 if not measured then
  -- Matcha TextBounds currently reports a fixed 7px per character even at
  -- size 11. Use proportional glyph advances and center the actual drawing.
  local advance=0
  for c in title:gmatch(".")do
   if c:match("[ilI%.,:;!|'`]")then advance+=.23
   elseif c==" "then advance+=.28
   elseif c:match("[mwMW@]")then advance+=.8
   elseif c:match("%u")then advance+=.62
   else advance+=.5 end
  end
  measured=math.floor(advance*11+.5);self.windyTextWidths[title]=measured
 end
 return math.min(available,measured+20)
end
function UI:WindySectionRows()
 local groups=self:WindyGroups()
 local available=self.window.width-self.window.sidebarWidth-38
 local rows,x=1,0
 for _,g in ipairs(groups)do
  local width=self:WindySectionWidth(g.name,available)
  if x>0 and x+width>available then rows+=1;x=0 end
  x+=width+5
 end
 return math.max(1,rows)
end
function UI:GetContentBounds()
