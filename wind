  local began=host.os.clock()
  local ok,reason=pcall(function()
   if jump then humanoid.Jump=true;env.task.wait(.35)end
   command:FireServer("Open")
   while host.os.clock()-began<15 do
    assert(player.Character and player.Character.Address==char.Address and nativeHum.Health>0,"return")
    local p=root.Position
    local dx,dz=target.X-p.X,target.Z-p.Z
    local distance=math.sqrt(dx*dx+dz*dz)
    if distance<3 and p.Y>=target.Y-2 and p.Y<=target.Y+6 then return end
