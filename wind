			logger.log("Puffshroom: Cannot farm in Coconut Field: Coconut Crab is alive")
			tracked.puffshrooms[puffshroom] = nil
			error("return", 0)
		end

		if not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
			logger.log(puffRarity, "Puffshroom (lvl:", puffLevel .. "): Found in", field.Name)
			setField(field.Name)

			if not (not cfg.convert.autoHoneyMask and not cfg.combat.demonmask or not (WindyMatchaBackend:IsTweenMovement(cfg.vars.movement) or cfg.convert.defaultMask ~= "Demon Mask")) then
