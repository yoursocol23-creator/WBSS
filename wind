	local function rarityMatches(cellType, rarities)
		for k in pairs(rarities) do
			if (k ~= "Any Common" or cellType ~= "BasicBee") and (k ~= "Any Rare" or not (cellType == "BomberBee" or cellType == "BraveBee" or cellType == "BumbleBee" or cellType == "CoolBee" or cellType == "HastyBee" or cellType == "LookerBee" or cellType == "RadBee" or cellType == "RascalBee" or cellType == "StubbornBee")) and (k ~= "Any Epic" or not (cellType == "BubbleBee" or cellType == "BuckoBee" or cellType == "CommanderBee" or cellType == "DemoBee" or cellType == "ExhaustedBee" or cellType == "FireBee" or cellType == "FrostyBee" or cellType == "HoneyBee" or cellType == "RageBee" or cellType == "RileyBee" or cellType == "ShockedBee")) and (k ~= "Any Legendary" or not (cellType == "BabyBee" or cellType == "CarpenterBee" or cellType == "DemonBee" or cellType == "DiamondBee" or cellType == "LionBee" or cellType == "MusicBee" or cellType == "NinjaBee" or cellType == "ShyBee")) and (k ~= "Any Mythic" or not (cellType == "BuoyantBee" or cellType == "FuzzyBee" or cellType == "PreciseBee" or cellType == "SpicyBee" or cellType == "TadpoleBee" or cellType == "VectorBee")) then
				continue
			end
			return true
		end
	end

