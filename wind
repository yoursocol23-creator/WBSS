		local function collectFuzzBomb(object)
			local metrics=WindyMatchaBackend.fuzzMetrics or{attempts=0,retargets=0,reached=0}
			WindyMatchaBackend.fuzzMetrics=metrics;metrics.attempts+=1
			local owner=object and object.Parent
			local began=os.clock()
			local lastMove,lastPoint=-math.huge,nil
			while os.clock()-began<3 do
				local point=WindyMatchaBackend:TargetPosition(object)
				if not point or not owner or not tracked.fuzzbombs[owner]then break end
				if distanceTo(point,true)<2 then metrics.reached+=1;break end
				local now=os.clock()
				local moved=not lastPoint or (point-lastPoint).Magnitude>=2
				if now-lastMove>=0.3 and(moved or now-lastMove>=1.5)then
					getHumanoid():MoveTo(point);metrics.retargets+=1;lastMove=now;lastPoint=point
				end
				if not RunService.Heartbeat:Wait()then break end
			end
			if owner then tracked.fuzzbombs[owner]=nil end
			return true
		end

