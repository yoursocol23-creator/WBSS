function UI:WindyAnimate(dt)
 local target=self.searchFocused and 1 or 0
 local current=self.windySearchFocus or 0
 local nextValue=current+(target-current)*math.min(1,(dt or 0)*16)
 if math.abs(nextValue-target)<.005 then nextValue=target end
 if nextValue~=current then self.windySearchFocus=nextValue;self:MarkShellDirty()end
 local morph=self.windyMorph
 if morph then
  morph.elapsed+=dt or 0
  local t=math.clamp(morph.elapsed/.24,0,1)
  morph.value=morph.from+(morph.to-morph.from)*(1-(1-t)^3)
  if t>=1 then self.windyMorph=nil;self:MarkCurrentTabDirty()end
  self:MarkShellDirty()
 end
end
