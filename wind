 local player=host.game:GetService("Players").LocalPlayer
 local parts={Part=true,MeshPart=true,UnionOperation=true,WedgePart=true,CornerWedgePart=true}
 local evaluationOffset
 if host.isfile and host.isfile("Windy-1/offsets.txt")then
  local source=host.readfile("Windy-1/offsets.txt")
  local body=source:match("namespace%s+Humanoid%s*{(.-)}")
  evaluationOffset=body and tonumber(body:match("uintptr_t%s+EvaluateStateMachine%s*=%s*(0x%x+)"))
 end
 local function suspendEvaluation(job,humanoid)
  -- Only the explicitly selected legacy mode owns the old animation-state hack.
  if not service.getMovementMode or service.getMovementMode()~="1:1 Tween"then return end
  if not evaluationOffset or evaluationOffset<=0 or not host.memory_read or not host.memory_write then return end
  local address=humanoid.Address
  local value=host.memory_read("byte",address+evaluationOffset)
  assert(value==0 or value==1,"Invalid Humanoid state-evaluation flag")
  if value==0 then return end
  -- Keep Roblox's current animation/state; do not fabricate a Physics state by
  -- changing the ID inside a different native state object.
  job.evaluation={humanoid=humanoid,address=address,value=value}
  host.memory_write("byte",address+evaluationOffset,0)
 end
 function service:Stop(reason)
  self.generation+=1
  local job=self.job;self.job=nil
  if not job then return end
  job.reason=reason or"cancelled"
  local evaluation=job.evaluation
  if evaluation then
   local character=player.Character
   if character and character.Address==job.character and evaluation.humanoid.Parent and evaluation.humanoid.Address==evaluation.address then
    local ok,problem=pcall(host.memory_write,"byte",evaluation.address+evaluationOffset,evaluation.value)
    if not ok then host.warn("[Windy tween state restore]",problem)end
   end
  end
  for _,entry in ipairs(job.collisions)do
   if entry.part.Address==entry.address and entry.part.Parent then
    pcall(function()entry.part.CanCollide=entry.value end)
   end
  end
